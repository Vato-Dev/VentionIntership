{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "grpc-route": {
        "ClusterId": "grpc-backend-cluster",
        "Match": {
          "Path": "/{**catch-all}"
        },
        "Transforms": [
          { "PathSet": "/{catch-all}" }
        ]
      }
    },
    "Clusters": {
      "grpc-backend-cluster": {
        "HttpRequest": {
          "Version": "2.0",
          "VersionPolicy": "RequestVersionExact"
        },
        "Destinations": {
          "grpc-service-1": {
            "Address": "https://localhost:7108"
          }
        }
      }
    }
  }
}